{
  "name": "screenbridge-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/gen_tokens.mjs",
    "content": "python3 -I scripts/extract_webflow.py",
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "preview": "python3 -m http.server 4173 --directory dist",
    "parity": "python3 -I scripts/check_parity.py http://localhost:4173"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "marked": "^14.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.28.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
