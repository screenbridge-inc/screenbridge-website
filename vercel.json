{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/ctv-media-buying-services",
      "destination": "/reach",
      "permanent": true
    },
    {
      "source": "/performance-plan",
      "destination": "/creative",
      "permanent": true
    }
  ]
}
